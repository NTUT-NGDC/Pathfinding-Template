## 讀一張地圖到 search（牆、起點、終點）
static func apply(map: Array, search: GridSearch, swamp_cost: float = SWAMP_COST) -> void:
	search.walls.clear()
	search.costs.clear()
	search.size = Vector2i(map[0].length(), map.size())
	for y: int in map.size():
		var row: String = map[y]
		for x: int in row.length():
			match row[x]:
				"#": search.walls[Vector2i(x, y)] = true
				"~": search.costs[Vector2i(x, y)] = swamp_cost
				"S": search.start_cell = Vector2i(x, y)
				"G": search.goal_cell = Vector2i(x, y)


## 把 search 現在的地圖轉成文字（存檔用）
static func to_rows(search: GridSearch) -> PackedStringArray:
	var rows: PackedStringArray = []
	for y: int in search.size.y:
		var row: String = ""
		for x: int in search.size.x:
			var cell: Vector2i = Vector2i(x, y)
			if cell == search.start_cell:
				row += "S"
			elif cell == search.goal_cell:
				row += "G"
			else:
				row += "#" if search.walls.has(cell) else "~" if search.costs.has(cell) else "."
		rows.append(row)
	return rows
