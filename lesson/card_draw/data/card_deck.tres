[gd_resource type="Resource" script_class="CardDeck" format=3]

[ext_resource type="Script" path="res://lesson/card_draw/scripts/card_deck.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
killers = "順風耳：聽力倍率 2，但巡邏很慢
近視：視野距離很短，但追起來很快
鷹眼：看得超遠，但反應很慢
神經質：反應時間 0，一看到就追
健忘：關掉「記住最後位置」
背後長眼睛：視野 360 度，但走很慢
聾子：沒有耳朵，但視野很寬
守門員：沒有巡邏點，站在出口附近張望
巡邏狂：巡邏點很多，繞整棟房子
雙胞胎：兩隻殺手，巡邏路線交錯
埋伏型：站在任務旁邊，很少移動
衝刺型：追得比玩家跑步還快，但很快放棄
固執：搜尋時間超長，一直找
轉頭很慢：可以從牠旁邊溜過去
一大群：3 隻以上，每隻都很弱"
places = "夜晚的學校
醫院
廢棄遊樂園
圖書館（書櫃排成走道）
地下室
大豪宅
船艙
超市（貨架排成一排一排）
辦公室（很多小隔間）
溫室（到處都是草叢）
玻璃屋（到處都是玻璃）
迷宮花園
太空站
古堡
便利商店"
goals = "修理 3 台機器
找 2 把鑰匙，開 2 道門
修理 1 台＋鑰匙 1 把
鑰匙放在殺手的巡邏路線上
修理點放在玻璃旁邊（殺手看得到你在修）
出口在離起點最遠的地方
只要 1 把鑰匙，但要經過殺手的房間
修理要修很久（15 秒以上）
修理很吵（聲音範圍很大）
沒有躲藏點
很多躲藏點，但殺手也很多隻
鑰匙門後面還有鑰匙門
所有任務都在同一個房間
任務分散在房子的四個角落
出口只要求部分任務，其他的是捷徑或陷阱"
