; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pathfinding Escape Template"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SoundSettings="*res://game/sound_settings/scripts/sound_settings.gd"
SoundBus="*res://game/ai/hearing/scripts/sound_bus.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://_system/fonts/Cubic_11.woff2"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
run={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
debug_vision={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
debug_path={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
debug_state={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
debug_sound={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}
debug_grid={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":53)]
}

[layer_names]

2d_physics/layer_1="擋路"
2d_physics/layer_2="擋視線"
2d_physics/layer_3="玩家"
2d_physics/layer_4="殺手"
2d_physics/layer_5="互動"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
